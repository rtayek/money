{
  "manifest_version": 3,
  "name": "Simplifi Transaction Probe",
  "version": "0.7.6",
  "description": "Locally matches Simplifi exports and prepares or saves one-line notes for confirmed exact matches.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Simplifi Transaction Probe"
  },
  "content_scripts": [
    {
      "matches": [
        "https://simplifi.quicken.com/*"
      ],
      "js": [
        "probe-core.js",
        "matcher-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
